<?xml version="1.0" ?>
<!--
  Campus test environment: a walled courtyard about 50 x 35 m with buildings,
  planters and bollards.

  The layout is chosen so the environment is actually mappable and localisable.
  A bare walled box gives a 2D LiDAR nothing to scan-match against along the
  walls, and AMCL slides freely down them. The internal blocks and the bollard
  row break that symmetry, which is what makes SLAM and AMCL behave.

  The campus_loop benchmark route (40 x 25 m with 3 m corners, starting at
  (3, 0) heading east) fits inside the courtyard with clearance.
-->
<sdf version="1.6">
  <world name="campus">

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Perimeter walls. The courtyard spans roughly x in [-6, 46] and
      y in [-6, 31], which contains the campus_loop route with margin.
    -->
    <model name="perimeter">
      <static>true</static>

      <link name="wall_south">
        <pose>20 -6 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="wall_north">
        <pose>20 31 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-6 12.5 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>46 12.5 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Central building block, inside the campus_loop ring. This is the main
      feature that makes the map asymmetric and gives the scan matcher
      something to lock onto.
    -->
    <model name="library">
      <static>true</static>
      <link name="link">
        <pose>20 12.5 1.75 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>18 10 3.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>18 10 3.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Residential</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asymmetric annexe, so the courtyard cannot be confused end for end. -->
    <model name="annexe">
      <static>true</static>
      <link name="link">
        <pose>34 20 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>6 5 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6 5 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="bike_shed">
      <static>true</static>
      <link name="link">
        <pose>4 22 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>4 7 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>4 7 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Planters outside the route, useful landmarks for scan matching. -->
    <model name="planter_a">
      <static>true</static>
      <link name="link">
        <pose>-3 4 0.4 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>1.2 3.0 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.2 3.0 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="planter_b">
      <static>true</static>
      <link name="link">
        <pose>43 27 0.4 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>3.0 1.2 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3.0 1.2 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bollard row along the south approach. -->
    <model name="bollards">
      <static>true</static>
      <link name="b1">
        <pose>10 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
      <link name="b2">
        <pose>14 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
      <link name="b3">
        <pose>18 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
