<?xml version="1.0" ?>
<!--
  Campus test environment: a walled courtyard about 50 x 35 m with buildings,
  planters and bollards.

  The layout is chosen so the environment is actually mappable and localisable.
  A bare walled box gives a 2D LiDAR nothing to scan-match against along the
  walls and AMCL slides freely down them. The internal blocks and the bollard
  row break that symmetry, which is what makes SLAM and AMCL behave.

  The campus_loop benchmark route (40 x 25 m with 3 m corners, starting at
  (3, 0) heading east) fits inside the courtyard with clearance.
-->
<sdf version="1.9">
  <world name="campus">

    <!-- Directional light in place of Classic's model://sun include, which
         modern Gazebo does not ship locally. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      gz-sim loads nothing by default: physics, the entity factory that
      ros_gz_sim's create uses to spawn the robot, the scene broadcaster, the
      rendering sensors (LiDAR and camera, ogre2) and the IMU are all systems.
    -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="2ms" type="dart">
      <!-- DART, gz-sim's default engine, in place of Classic's ODE. The
           step size and real-time pacing are unchanged. -->
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Perimeter walls. The courtyard spans roughly x in [-6, 46] and
      y in [-6, 31], which contains the campus_loop route with margin.
    -->
    <model name="perimeter">
      <static>true</static>

      <link name="wall_south">
        <pose>20 -6 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_north">
        <pose>20 31 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>54 0.3 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-6 12.5 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>46 12.5 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 37 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Central building block, inside the campus_loop ring. This is the main
      feature that makes the map asymmetric and gives the scan matcher
      something to lock onto.
    -->
    <model name="library">
      <static>true</static>
      <link name="link">
        <pose>20 12.5 1.75 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>18 10 3.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>18 10 3.5</size></box></geometry>
          <material>
            <ambient>0.78 0.72 0.62 1</ambient>
            <diffuse>0.78 0.72 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asymmetric annexe, so the courtyard cannot be confused end for end. -->
    <model name="annexe">
      <static>true</static>
      <link name="link">
        <pose>34 20 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>6 5 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6 5 2.5</size></box></geometry>
          <material>
            <ambient>0.62 0.30 0.24 1</ambient>
            <diffuse>0.62 0.30 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bike_shed">
      <static>true</static>
      <link name="link">
        <pose>4 22 1.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>4 7 2.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>4 7 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Planters outside the route, useful landmarks for scan matching. -->
    <model name="planter_a">
      <static>true</static>
      <link name="link">
        <pose>-3 4 0.4 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>1.2 3.0 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.2 3.0 0.8</size></box></geometry>
          <material>
            <ambient>0.25 0.55 0.25 1</ambient>
            <diffuse>0.25 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="planter_b">
      <static>true</static>
      <link name="link">
        <pose>43 27 0.4 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>3.0 1.2 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3.0 1.2 0.8</size></box></geometry>
          <material>
            <ambient>0.25 0.55 0.25 1</ambient>
            <diffuse>0.25 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bollard row along the south approach. -->
    <model name="bollards">
      <static>true</static>
      <link name="b1">
        <pose>10 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
      <link name="b2">
        <pose>14 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
      <link name="b3">
        <pose>18 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
