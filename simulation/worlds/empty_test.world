<?xml version="1.0" ?>
<!--
  Obstacle-free world for the controller comparison.

  The comparison measures path tracking and nothing else. Running it in the
  furnished campus world is actively wrong: several benchmark routes were laid
  out in their own coordinates and pass straight through the buildings, so the
  robot drives into a wall and the run records a stall that has nothing to do
  with the control law. (The `corner` route's final leg runs through the
  library.)

  Obstacle avoidance belongs in the Nav2 demo, which uses campus.world. Here a
  ground plane is all that is wanted.
-->
<sdf version="1.6">
  <world name="empty_test">

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- 0 means "as fast as the machine allows", which matters because the
           comparison is run headless in CI-like conditions where wall-clock
           time is the limiting factor, not fidelity. -->
      <real_time_update_rate>0</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
