<?xml version="1.0"?>
<!--
  Differential-drive campus shuttle.

  Dimensions match the parameters used by the offline benchmark
  (wheel separation 0.52 m, wheel radius 0.10 m) so the plant the controllers
  are tuned against and the plant they are simulated on agree.
-->
<robot name="shuttle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.90"/>
  <xacro:property name="base_width"  value="0.46"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_mass"   value="28.0"/>

  <xacro:property name="wheel_radius"     value="0.10"/>
  <xacro:property name="wheel_width"      value="0.06"/>
  <xacro:property name="wheel_mass"       value="1.2"/>
  <xacro:property name="wheel_separation" value="0.52"/>
  <xacro:property name="wheel_xoff"       value="0.20"/>

  <xacro:property name="caster_radius" value="0.045"/>

  <xacro:include filename="$(find shuttle_description)/urdf/shuttle.gazebo.xacro"/>

  <material name="shuttle_blue">
    <color rgba="0.15 0.35 0.65 1.0"/>
  </material>
  <material name="shuttle_dark">
    <color rgba="0.15 0.15 0.17 1.0"/>
  </material>
  <material name="shuttle_grey">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0*m*r*r/5.0}" iyz="0.0"
        izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- base_footprint sits on the ground plane directly below base_link. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="shuttle_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}"
                       z="${base_height}"/>
  </link>

  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="shuttle_dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}"
                              h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_xoff} ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- Passive rear caster, modelled as a low-friction sphere. -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="shuttle_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="0.4" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-base_length/2 + 0.10} 0 ${-wheel_radius + caster_radius}"/>
  </joint>

  <!-- 2D LiDAR on the roof. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="shuttle_dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.20" r="0.045" h="0.06"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.24 0 ${base_height + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- IMU at the base origin. -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Forward-facing RGB camera, the calibration subject. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="shuttle_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.12" x="0.03" y="0.09" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.40 0 ${base_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!--
    Optical frame: REP 103 says camera data is expressed with z forward, x
    right and y down, which is a fixed rotation from the ROS body convention.
    The camera-to-LiDAR extrinsic calibration solves for the transform between
    lidar_link and this frame, so it has to exist explicitly.
  -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <xacro:shuttle_gazebo
    wheel_separation="${wheel_separation}"
    wheel_radius="${wheel_radius}"/>

</robot>
