<?xml version="1.0"?>
<!--
  Gazebo (gz-sim, Harmonic) systems and sensors: differential drive, joint
  states, a ground-truth pose source, 2D LiDAR, IMU and RGB camera.

  Every topic is given an absolute name that matches the ROS name it is bridged
  to, so config/gz_bridge.yaml in shuttle_bringup reads as a straight list of
  topic, type and direction. Sensor specifications (rates, resolution, range,
  field of view, noise) are carried over unchanged from the Gazebo Classic
  model this replaces, so the robot the controllers see is the same robot.

  The odometry publisher is the reason the simulation results are trustworthy.
  It publishes the exact model pose from the physics engine, which is what the
  metrics are computed against. Without it the only available "truth" would be
  the EKF estimate and a controller that tracked a drifting estimate perfectly
  would score perfectly while driving off the path.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="shuttle_gazebo" params="wheel_separation wheel_radius">

    <!-- Contact properties. The URDF converter turns mu1/mu2 into the SDF
         surface friction and kp/kd into contact stiffness and damping. -->
    <gazebo reference="left_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>10.0</kd>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>10.0</kd>
    </gazebo>
    <gazebo reference="caster_link">
      <!-- Near-frictionless, so the caster does not fight the drive wheels. -->
      <mu1>0.02</mu1>
      <mu2>0.02</mu2>
    </gazebo>

    <!--
      Differential drive. Publishes wheel odometry on /wheel/odom. Its own
      odom -> base_footprint transform goes to a model-scoped topic that is not
      bridged: robot_localization owns that edge and two publishers for one
      transform would make the tree flicker between two answers.

      The acceleration limits reproduce the Classic plugin's
      max_wheel_acceleration of 4.0, which that plugin applied to the wheel rim
      speed in m/s^2: 4.0 m/s^2 linear and 2 x 4.0 / 0.52 = 15.4 rad/s^2 about
      the vertical axis for wheels driven in opposite directions.

      Odometry is integrated from the wheel joint angles, as an encoder would
      give it. The Classic model used odometry_source 1 (the world pose), so the
      wheel odometry here is the more realistic of the two.
    -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/wheel/odom</odom_topic>
        <tf_topic>/model/shuttle/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>4.0</max_linear_acceleration>
        <min_linear_acceleration>-4.0</min_linear_acceleration>
        <max_angular_acceleration>15.4</max_angular_acceleration>
        <min_angular_acceleration>-15.4</min_angular_acceleration>
      </plugin>
    </gazebo>

    <!-- Joint states for robot_state_publisher. -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- Ground truth pose, straight from the physics engine, in the world
         frame. Planar (dimensions 2), noise free, 50 Hz. -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/ground_truth/odom</odom_topic>
        <odom_covariance_topic>/model/shuttle/ground_truth_with_covariance</odom_covariance_topic>
        <tf_topic>/model/shuttle/ground_truth_tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>

    <!-- 2D LiDAR, 360 degrees, 720 samples, 10 Hz. -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.16</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.012</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- IMU, 100 Hz. -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>/imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.0001</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- RGB camera, 1280 x 720 at 15 Hz. Publishes camera_info, which the
         extrinsic calibration needs for the intrinsics. Images are labelled in
         the REP 103 optical frame. -->
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.089</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
