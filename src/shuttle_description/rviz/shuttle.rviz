Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 160; 160; 164
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /scan
      Size (m): 0.03
      Style: Points
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Path
      Name: Reference path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /plan
      Color: 25; 255; 0
      Line Style: Lines
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /ground_truth/odom
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 255; 25; 0
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
        Value: Arrow
    - Class: rviz_default_plugins/Odometry
      Name: EKF estimate
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /odometry/filtered
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 0; 130; 255
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
        Value: Arrow
    - Class: rviz_default_plugins/Camera
      Name: Camera
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /camera/image_raw
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Focal Point:
        X: 20
        Y: 12
        Z: 0
      Pitch: 1.0
      Yaw: 1.5
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
